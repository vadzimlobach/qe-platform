{
  "name": "qe-platform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:accessibility": "playwright test tests/accessibility",
    "test:performance": "k6 run -e API_BASE_URL=http://localhost:3000 tests/performance/api-smoke.ts",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "allure:generate": "mkdir -p allure-results && cp -R allure-report/history allure-results/history 2>/dev/null || true && allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open ./allure-report",
    "mock-api": "tsx mock-api/src/server.ts",
    "type-check:k6": "tsc -p tsconfig.k6.json",
    "docker:build": "docker compose build",
    "test:docker": "docker compose run --rm tests",
    "docker:down": "docker compose down --remove-orphans",
    "docker:build:clean": "docker build --no-cache -t playwright-quality-platform ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@types/express": "^5.0.6",
    "@types/k6": "^1.7.0",
    "@types/node": "^25.6.0",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.7.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "k6": "^0.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}